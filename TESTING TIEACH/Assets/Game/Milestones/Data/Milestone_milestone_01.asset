  m_Script: {fileID: 11500000, guid: 00d6f36f76393b34386043860fe93167, type: 3}
  m_Name: Milestone_milestone_01
  m_EditorClassIdentifier: Assembly-CSharp::MilestoneDefinition
  milestoneId: milestone_01
  displayName: Process Flow
  description: Connect stations and observe how work moves from ingredients to finished items.
  completionDialogue:
  - You mapped how work moves through the kitchen and found where it waits. That
    is process analysis.
  - Keep the stations close and the path simple. A shorter route gives us more time
    to serve orders.
  isTutorial: 0
  minimumSystemEfficiencyPercent: 25
  minimumCustomersServedPercent: 50
  missions:
  - {fileID: 11400000, guid: 7a8ccd56baa7476eb83291c1650c9c38, type: 2}
  - {fileID: 11400000, guid: 6f00fbb8c62d483fa25b7b6d00eccc3a, type: 2}
  - {fileID: 11400000, guid: 9e1b233836794be39df5ebcb1f007023, type: 2}
  shiftQuestions:
  - questionId: core_process
    prompt: "What is a process?"
    answers:
    - "Connected steps that turn ingredients into a finished item"
    - "A single station working by itself"
    - "A list of menu prices"
    correctAnswerIndex: 0
    explanation: "A process connects work steps from inputs to finished output."
  - questionId: core_bottleneck
    prompt: "What does a bottleneck limit?"
    answers:
    - "The finished output of the whole process"
    - "The price of each recipe"
    - "The number of stations in the restaurant"
    correctAnswerIndex: 0
    explanation: "The bottleneck is the step that limits how quickly the process can finish items."
  - questionId: core_queue
    prompt: "What can a growing queue tell you?"
    answers:
    - "The next step cannot keep up with incoming work"
    - "The whole process has extra capacity"
    - "The item is already ready for pickup"
    correctAnswerIndex: 0
    explanation: "A queue grows when work arrives faster than the next process step can handle it."
  shiftLessons:
  - lessonId: core_process
    title: "Follow the process"
    explanation: "A process is connected steps that turn ingredients into finished items. Check how each step links to the next."
    target: 1
  - lessonId: core_bottleneck
    title: "Find the bottleneck"
    explanation: "The bottleneck is the step that limits finished output. Improving another step may not increase the whole process output."
    target: 0
  - lessonId: core_queue
    title: "Read the queue"
    explanation: "A growing queue means work is arriving faster than the next step can handle it."
    target: 1
  missionDatabase: {fileID: 0}
  quiz: {fileID: 0}
  unlocks: []
