MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 00d6f36f76393b34386043860fe93167, type: 3}
  m_Name: Milestone_milestone_03
  m_EditorClassIdentifier: Assembly-CSharp::MilestoneDefinition
  milestoneId: milestone_03
  displayName: Supply Planning
  description: Estimate ingredient use and set supply rates to support production.
  completionDialogue:
  - You planned ingredient supply around what production needs.
  - Keep stock available for the process without ordering far beyond expected use.
  isTutorial: 0
  minimumSystemEfficiencyPercent: 35
  minimumCustomersServedPercent: 60
  missions:
  - {fileID: 11400000, guid: 720b3bc1d4e94236af25b99cfc37e39a, type: 2}
  - {fileID: 11400000, guid: 2f81f5e24e884a3890e7bf3f4f9d1eff, type: 2}
  shiftQuestions:
  - questionId: core_supply_rate
    prompt: "What should guide the supply rate for a process?"
    answers:
    - "How quickly the process is expected to use that ingredient"
    - "The highest rate the supplier allows, regardless of need"
    - "The number of stations placed in the kitchen"
    correctAnswerIndex: 0
    explanation: "Match incoming supply to expected use so production has inputs without building excess stock."
  - questionId: core_input_flow
    prompt: "What can happen if ingredients arrive slower than a process uses them?"
    answers:
    - "A process step may run out and become starved"
    - "The completed output rate must increase"
    - "Customer demand is automatically reduced"
    correctAnswerIndex: 0
    explanation: "When supply cannot keep up with use, a step may wait for inputs and finished output can drop."
  - questionId: core_excess
    prompt: "Why avoid excess stock for a process?"
    answers:
    - "Excess stock ties up money and may go unused"
    - "It always improves throughput"
    - "It removes the need to plan supply"
    correctAnswerIndex: 0
    explanation: "Plan supply around the process, bringing in enough stock without tying up money in ingredients you may not use."
  shiftLessons:
  - lessonId: core_supply_rate
    title: "Match supply to use"
    explanation: "Set each ingredient's supply rate around how quickly the process is expected to use it."
    target: 1
  - lessonId: core_input_flow
    title: "Keep inputs moving"
    explanation: "If ingredients arrive too slowly, a process step can wait for inputs and finished output falls."
    target: 1
  - lessonId: core_excess
    title: "Avoid excess stock"
    explanation: "Bring in enough stock to support the process without tying up money in ingredients you may not use."
    target: 1
  missionDatabase: {fileID: 0}
  quiz: {fileID: 0}
  unlocks: []
