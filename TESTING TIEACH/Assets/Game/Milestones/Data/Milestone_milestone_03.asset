  shiftQuestions:
  - questionId: supply_forecast
    prompt: "What tells you how much of an ingredient you may need?"
    answers:
    - "The Forecast column"
    - "The station purchase price"
    - "The song title"
    correctAnswerIndex: 0
    explanation: "Compare Forecast with Stock when planning deliveries."
  - questionId: supply_apply
    prompt: "Which button puts your delivery rates into effect?"
    answers:
    - "Apply Supply Plan"
    - "Edit Menu"
    - "New Flow"
    correctAnswerIndex: 0
    explanation: "Apply Supply Plan saves the selected delivery rates."
  - questionId: supply_full
    prompt: "When do deliveries stop for an ingredient?"
    answers:
    - "When its stock is full"
    - "When you open Objectives"
    - "When you move the camera"
    correctAnswerIndex: 0
    explanation: "Deliveries stop at the stock limit and can resume when there is room."
