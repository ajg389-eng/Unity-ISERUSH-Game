  m_EditorClassIdentifier: Assembly-CSharp::MilestoneDefinition
  milestoneId: milestone_04
  displayName: Measure and Improve
  description: Use delivered output to see whether a focused change improves the whole process.
  completionDialogue:
  - The data shows whether your change improved the process. Use it to choose what to fix next.
  - Check the whole system. Improving one station can move the bottleneck somewhere else.
  isTutorial: 0
  minimumSystemEfficiencyPercent: 50
  minimumCustomersServedPercent: 75
  missions:
  - {fileID: 11400000, guid: 9ca87026fb1d4a348ba9f31e225d7d0f, type: 2}
  - {fileID: 11400000, guid: 2d6eff8a216647678689348797f51cf0, type: 2}
  - {fileID: 11400000, guid: f273a94d2ab7449198238e0e6f0bb506, type: 2}
  shiftQuestions:
  - questionId: core_measure
    prompt: "What should you compare after changing a process step?"
    answers:
    - "Finished output from the whole process"
    - "Only the fastest station rate"
    - "The color of the station card"
    correctAnswerIndex: 0
    explanation: "Throughput measures finished output from the complete process."
  - questionId: core_one_change
    prompt: "Why change one likely cause at a time?"
    answers:
    - "It helps show which change affected process output"
    - "It guarantees every station reaches maximum capacity"
    - "It makes customer demand stop changing"
    correctAnswerIndex: 0
    explanation: "A focused change makes it easier to connect the cause to the result."
  - questionId: core_system
    prompt: "If one station's output rises but delivered throughput stays flat, what should you check?"
    answers:
    - "Another step may now limit the whole process"
    - "Only the upgraded station's target rate"
    - "Whether the menu has enough categories"
    correctAnswerIndex: 0
    explanation: "Improving one step can move the bottleneck to another part of the system."
  shiftLessons:
  - lessonId: core_measure
    title: "Measure throughput"
    explanation: "Compare delivered items before and after a change to see whether the whole process improved."
    target: 0
  - lessonId: core_one_change
    title: "Change one thing"
    explanation: "Changing one likely cause at a time helps you see what affected throughput."
    target: 0
  - lessonId: core_system
    title: "Check the whole system"
    explanation: "A change to one station can move the bottleneck elsewhere in the connected process."
    target: 0
  missionDatabase: {fileID: 0}
  quiz: {fileID: 0}
  unlocks: []
