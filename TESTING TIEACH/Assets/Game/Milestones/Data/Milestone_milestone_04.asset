  - questionId: check_output
    prompt: "After moving a station, what should you compare?"
    answers:
    - "How much food reaches Pickup"
    - "The station card color"
    - "The number of tabs open"
    correctAnswerIndex: 0
    explanation: "Use delivered output to see whether the layout helped."
  - questionId: check_shortfall
    prompt: "If Produced / Min is below Demand / Min, what does that mean?"
    answers:
