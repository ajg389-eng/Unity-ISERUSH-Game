%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 00d6f36f76393b34386043860fe93167, type: 3}
  m_Name: Milestone_milestone_04
  m_EditorClassIdentifier: Assembly-CSharp::MilestoneDefinition
  milestoneId: milestone_04
  displayName: Process Optimization
  description: Improve one product line and check how the change affects output across the kitchen.
  completionDialogue:
  - Find the step holding up the kitchen and change one thing at a time. Check what reaches Pickup and how many customers get served.
  - A faster station can move the bottleneck somewhere else. Follow the work through the whole kitchen before deciding what to improve next.
  isTutorial: 0
  minimumSystemEfficiencyPercent: 80
  minimumCustomersServedPercent: 70
  missions:
  - {fileID: 11400000, guid: 9ca87026fb1d4a348ba9f31e225d7d0f, type: 2}
  - {fileID: 11400000, guid: 2d6eff8a216647678689348797f51cf0, type: 2}
  - {fileID: 11400000, guid: f273a94d2ab7449198238e0e6f0bb506, type: 2}
  shiftQuestions:
  - questionId: check_output
    prompt: "Moving a worker to burgers lifts their forecast from 16 to 20 per minute. Fries drop from 20 to 15. Both need 20. What should you check before keeping the change?"
    answers:
    - "Whether the change helps customers get their whole orders"
    - "Whether burgers alone are now on target"
    - "Whether burgers have the fastest worker"
    correctAnswerIndex: 0
    explanation: "Fries now have a bigger shortfall than burgers had. Check all three outputs and customer service before keeping the new assignment."
  - questionId: check_shortfall
    prompt: "If Produced / Min is below Demand / Min, what does that mean?"
    answers:
    - "The kitchen is making less than customers are expected to order"
    - "Every customer was served"
    - "The kitchen is making too much"
    correctAnswerIndex: 0
    explanation: "Compare output with demand to see if production keeps up."
  - questionId: check_stock
    prompt: "You shift supplier capacity from buns to milk. Shakes have enough milk now, but the Supply plan shows buns running short. What should you do?"
    answers:
    - "Rebalance the rates and check both ingredient shortages"
    - "Keep the plan because shakes have enough milk"
    - "Raise the burger station's target to make up the difference"
    correctAnswerIndex: 0
    explanation: "The supplier limit is shared. Check where a change removes a shortage and where it creates one."
  - questionId: improve_baseline
    prompt: "You want to test a shorter burger route that uses a worker shared with fries. What should you record before changing it?"
    answers:
    - "The starting output forecast for all three menu items"
    - "How much the new station costs"
    - "How many items the supplier could deliver"
    correctAnswerIndex: 0
    explanation: "The starting rates help you see which lines gain or lose output after the change."
  - questionId: improve_change_one
    prompt: "Which test makes it easiest to tell whether a shorter walk helped?"
    answers:
    - "Move one station and compare the same item's output"
    - "Move several stations and change the menu at once"
    - "Change the menu and compare two different items"
    correctAnswerIndex: 0
    explanation: "A focused change makes it easier to see what affected the result."
  - questionId: improve_read_pickup
    prompt: "Live Analytics shows 20 shakes per minute. The day summary shows an average of 16. How can both be right?"
    answers:
    - "Live Analytics uses the last minute. The summary averages the whole shift."
    - "The summary only counts shakes in single-item orders."
    - "Live Analytics is a production forecast."
    correctAnswerIndex: 0
    explanation: "Produced / Min is a recent reading. The end-of-day average includes slow periods earlier in the shift."
  - questionId: improve_predicted_only
    prompt: "Predicted / Min rises, but Produced / Min stays the same. What should you conclude so far?"
    answers:
    - "Expected output rose, but actual output hasn't yet"
    - "The kitchen served more customers"
    - "The forecast for demand dropped"
    correctAnswerIndex: 0
    explanation: "Check what reached Pickup before judging the change."
  - questionId: improve_moved_bottleneck
    prompt: "The Grill now keeps up, but work starts piling up before Assembly. What likely changed?"
    answers:
    - "Assembly is now holding up the flow"
    - "Customers stopped ordering burgers"
    - "The Grill is still the only place to improve"
    correctAnswerIndex: 0
    explanation: "Improving one step can move the bottleneck to another step."
  - questionId: improve_follow_block
    prompt: "The Fryer is often Blocked. Which change should you investigate first?"
    answers:
    - "Make it easier for cooked fries to leave the Fryer"
    - "Deliver more raw potatoes to Cutting"
    - "Increase how many fries customers order"
    correctAnswerIndex: 0
    explanation: "Blocked means the station is waiting for its output to move onward."
  - questionId: improve_follow_starve
    prompt: "Assembly is often Starved after a layout change. What should you trace first?"
    answers:
    - "The ingredients and transfers that feed Assembly"
    - "Only deliveries from Assembly to Pickup"
    - "Only the customer path to the register"
    correctAnswerIndex: 0
    explanation: "A starved station is missing something it needs to do the work."
  - questionId: improve_wait
    prompt: "Output per minute rises, but average Order to Pickup time also rises. What should you do?"
    answers:
    - "Check the longer waits before judging the change"
    - "Assume the longer waits show an improvement"
    - "Use predicted output instead of live results"
    correctAnswerIndex: 0
    explanation: "Output and wait time tell you different things. Check both when judging an improvement."
  - questionId: improve_shortfall_math
    prompt: "Demand is 10 per minute. Output improved from 6 to 8. How far short are you now?"
    answers:
    - "2 items per minute"
    - "4 items per minute"
    - "8 items per minute"
    correctAnswerIndex: 0
    explanation: "Compare the new output of eight with demand of ten."
  - questionId: improve_more_grill
    prompt: "The Grill already supplies all the patties Assembly can use. Will another Grill automatically raise burger output?"
    answers:
    - "No, check what currently limits the whole flow"
    - "Yes, each Grill always raises finished output"
    - "Yes, as long as demand is higher than predicted"
    correctAnswerIndex: 0
    explanation: "Extra capacity helps when it addresses the step that limits finished output."
  - questionId: improve_same_conditions
    prompt: "How can you make a before-and-after comparison fairer?"
    answers:
    - "Compare the same menu item under similar demand"
    - "Compare a busy shift with a much quieter one"
    - "Compare one item's demand with another item's output"
    correctAnswerIndex: 0
    explanation: "Keeping the item and demand similar helps you judge the change you tested."
  - questionId: improve_end_to_end
    prompt: "A station makes more items after a change, but Pickup receives the same amount. What should you check?"
    answers:
    - "Where the extra output is waiting or getting stuck"
    - "Whether the station needs an even higher target"
    - "Whether the demand forecast should be ignored"
    correctAnswerIndex: 0
    explanation: "A station can make more without increasing finished deliveries if a later step cannot keep up."
  shiftLessons: []
  missionDatabase: {fileID: 0}
  quiz: {fileID: 0}
  unlocks: []
