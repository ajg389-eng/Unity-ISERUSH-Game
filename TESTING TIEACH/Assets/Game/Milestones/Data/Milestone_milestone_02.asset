  m_Script: {fileID: 11500000, guid: 00d6f36f76393b34386043860fe93167, type: 3}
  m_Name: Milestone_milestone_02
  m_EditorClassIdentifier: Assembly-CSharp::MilestoneDefinition
  milestoneId: milestone_02
  displayName: Demand and Capacity
  description: Compare how quickly customers order with how quickly the process can produce items.
  completionDialogue:
  - You are matching station capacity to the flow. A fast station cannot help if
    the next step cannot take its output.
  - Systems engineering means balancing the whole line, people and equipment together.
    Keep the work moving at the rate customers need.
  isTutorial: 0
  minimumSystemEfficiencyPercent: 30
  minimumCustomersServedPercent: 55
  missions:
  - {fileID: 11400000, guid: d1be50ffdb1743fd9372bd1d477f336f, type: 2}
  - {fileID: 11400000, guid: 507587f068654a1eb58b18c2a901c326, type: 2}
  - {fileID: 11400000, guid: ef8ec327ad06458ba97a3bb331545b9f, type: 2}
  shiftQuestions:
  - questionId: core_demand_capacity
    prompt: "How do demand and capacity relate?"
    answers:
    - "Capacity must keep up with the customer demand we plan to serve"
    - "Demand is the number of workers assigned to a flow"
    - "Capacity is the amount of money in the register"
    correctAnswerIndex: 0
    explanation: "Compare planned production capacity with the rate customers are expected to order."
  - questionId: core_throughput
    prompt: "What does throughput measure?"
    answers:
    - "Finished items delivered by the whole process over time"
    - "Items waiting at one station"
    - "The speed of the fastest station only"
    correctAnswerIndex: 0
    explanation: "Throughput is finished output from the complete process, not one station in isolation."
  - questionId: core_balance
    prompt: "If a queue grows before a station, what should you check?"
    answers:
    - "Whether that step has enough capacity for incoming work"
    - "Whether every station has the same purchase price"
    - "Whether the menu has too many categories"
    correctAnswerIndex: 0
    explanation: "Compare the step capacity with the flow of work arriving there."
  shiftLessons:
  - lessonId: core_demand_capacity
    title: "Compare demand and capacity"
    explanation: "Demand is what customers want. Capacity is how quickly the process can produce it."
    target: 0
  - lessonId: core_throughput
    title: "Track finished output"
    explanation: "Throughput is the rate finished items leave the whole process. Use delivered output to judge whether the kitchen keeps up."
    target: 0
  - lessonId: core_balance
    title: "Balance the process"
    explanation: "When connected steps have mismatched capacity, queues or idle time can form. Check the whole flow."
    target: 1
  missionDatabase: {fileID: 0}
  quiz: {fileID: 0}
  unlocks: []
