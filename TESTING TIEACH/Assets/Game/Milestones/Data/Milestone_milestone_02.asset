  - {fileID: 11400000, guid: ef8ec327ad06458ba97a3bb331545b9f, type: 2}
  shiftQuestions:
  - questionId: analytics_demand
    prompt: "Which Analytics column shows expected orders per minute?"
    answers:
    - "Demand / Min"
    - "Produced / Min"
    - "Open Orders"
    correctAnswerIndex: 0
    explanation: "Demand / Min is the forecast for that item."
  - questionId: analytics_pickup
    prompt: "What does Produced / Min count?"
    answers:
    - "Items that reach Pickup"
    - "Stations you bought"
    - "Ingredients in storage"
    correctAnswerIndex: 0
    explanation: "Produced / Min measures finished items delivered to Pickup."
  - questionId: analytics_bottleneck
    prompt: "What does a bottleneck limit?"
    answers:
    - "How much the whole line can finish"
    - "How many menu items you can unlock"
    - "How far the camera can zoom"
    correctAnswerIndex: 0
    explanation: "The limiting step determines how much finished output the line can deliver."
