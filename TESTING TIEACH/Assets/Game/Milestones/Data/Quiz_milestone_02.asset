--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dd62bf0e9b3a5eb45846a85a8561b632, type: 3}
  m_Name: Quiz_milestone_02
  m_EditorClassIdentifier: Assembly-CSharp::QuizDefinition
  quizId: milestone_02_quiz
  title: Capacity & Optimization Quiz
  introText: Answer every question correctly to unlock the next milestone.
  questions:
  - prompt: The grill is 98% utilized while assembly is 55% utilized, and orders
      are piling up before the grill. Where should additional capacity most likely
      be added?
    choices:
    - Assembly
    - Grill
    - Pantry
    - Customer seating
    correctChoiceIndex: 1
  - prompt: After adding another grill, assembly becomes heavily utilized and orders
      begin waiting there. What happened?
    choices:
    - Demand disappeared
    - The bottleneck shifted
    - The new grill reduced capacity
    - Inventory became unnecessary
    correctChoiceIndex: 1
  - prompt: You have enough money for either another grill or another employee. What
      should you analyze first?
    choices:
    - Which option looks better
    - Which resource is currently limiting system performance
    - Which option costs more
    - Which option was unlocked most recently
    correctChoiceIndex: 1
  - prompt: One worker is overloaded while another worker spends significant time
      idle. What is the best first response?
    choices:
    - Increase customer demand
    - Reallocate work between employees
    - Raise prices
    - Increase inventory
    correctChoiceIndex: 1
