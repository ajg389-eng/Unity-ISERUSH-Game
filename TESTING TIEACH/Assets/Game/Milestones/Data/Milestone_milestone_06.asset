  milestoneId: milestone_06
  displayName: Whole-System Improvement
  description: Check how connected parts of the kitchen work together and find what limits output.
  completionDialogue:
  - Supplier capacity is higher, but the process still sets what the kitchen can finish.
  - Add supply where the whole system needs it, then check delivered output.
  isTutorial: 0
  minimumSystemEfficiencyPercent: 50
  minimumCustomersServedPercent: 75
  missions:
  - {fileID: 11400000, guid: f4dd5e7666294f548dd18355eb390375, type: 2}
  - {fileID: 11400000, guid: 2d6eff8a216647678689348797f51cf0, type: 2}
  - {fileID: 11400000, guid: f273a94d2ab7449198238e0e6f0bb506, type: 2}
  shiftQuestions:
  - questionId: core_connected_system
    prompt: "What makes the kitchen a system?"
    answers:
    - "Stations, workers, ingredients, and customer demand affect one another"
    - "Each station works independently of every other part"
    - "Only the final station affects finished output"
    correctAnswerIndex: 0
    explanation: "The whole system's result depends on how its connected parts work together."
  - questionId: core_whole_output
    prompt: "Which measure best shows what the whole process completed?"
    answers:
    - "Finished items delivered to Pickup over time"
    - "The target of one station"
    - "The number of workers hired"
    correctAnswerIndex: 0
    explanation: "Delivered throughput shows the output that made it through the complete process."
  - questionId: core_improve
    prompt: "What is a good way to improve a system?"
    answers:
    - "Find a problem, make a focused change, and compare the result"
    - "Increase every station target without checking demand"
    - "Judge performance by one station alone"
    correctAnswerIndex: 0
    explanation: "Continuous improvement uses evidence from the whole process to guide the next change."
  shiftLessons:
  - lessonId: core_connected_system
    title: "See the connected system"
    explanation: "Stations, workers, ingredients, and demand affect one another. ISE looks at how the whole system performs."
    target: 0
  - lessonId: core_whole_output
    title: "Measure whole-process output"
    explanation: "Items delivered to Pickup show what completed the whole process, not just what one station made."
    target: 0
  - lessonId: core_improve
    title: "Use continuous improvement"
    explanation: "Find a problem, make a focused change, and compare the whole-process result."
    target: 0
